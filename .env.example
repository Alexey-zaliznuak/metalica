# Public application URL. Production links are generated as
# https://metallity-crm.ru/files/<s3-key>.
APP_DOMAIN=metallity-crm.ru
APP_PROTOCOL=https
APP_PORT=3000
# Increase this value to invalidate previously cached file responses.
FILES_URL_VERSION=1

# Replace every secret before production deployment.
JWT_SECRET=change-me-to-a-long-random-value
JWT_EXPIRES_IN=7d

POSTGRES_USER=metalica
POSTGRES_PASSWORD=change-me
POSTGRES_DB=metalica
DATABASE_URL=postgresql://metalica:change-me@postgres:5432/metalica

# Keep MINIO_ROOT_* and MINIO_ACCESS/SECRET_* values identical.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=metalica
MINIO_REGION=us-east-1
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

MAX_UPLOAD_MB=1024
STUCK_REVISION_HOURS=24

# Автораспределение заказов между художниками работает только внутри окна
# [START_HOUR; END_HOUR) в указанном часовом поясе. Заказы, вошедшие в статус
# вне окна, назначают вручную и автоматически они уже не подхватываются.
AUTO_ASSIGN_TZ=Europe/Moscow
AUTO_ASSIGN_START_HOUR=10
AUTO_ASSIGN_END_HOUR=21
# Ежевечерний сброс статуса «На смене» у всех художников (в AUTO_ASSIGN_TZ).
SHIFT_RESET_CRON=0 21 * * *

# Включение интеграции и учётные данные BlueSales (PRO-аккаунт).
BLUESALES_ENABLED=true
BLUESALES_LOGIN=
BLUESALES_PASSWORD=
# id сообщества ВК для ссылок на диалоги (можно оставить пустым).
BLUESALES_VK_GROUP_ID=

# Полный синк при старте: если true — один раз при запуске бэка подтянет ВСЕ
# заказы и лиды за последние BLUESALES_SYNC_DAYS дней. Держите false в обычной
# работе; включайте разово для первичной загрузки истории.
BLUESALES_FULL_SYNC=false
# Период полного синка (в днях).
BLUESALES_SYNC_DAYS=365
# Размер окна полного синка (в днях) — период дробится, чтобы не грузить BS API.
BLUESALES_FULL_SYNC_WINDOW_DAYS=7

# Cron быстрого инкрементального синка заказов.
BLUESALES_FAST_SYNC_CRON=*/5 * * * *
# Перекрытие окна быстрого синка (мин), чтобы не терять заказы на границе.
BLUESALES_FAST_SYNC_OVERLAP_MINUTES=70

# Refresh-loop заказов: размер пачки, пауза (мс) и глубина (дни) актуализации.
BLUESALES_REFRESH_BATCH_SIZE=50
BLUESALES_REFRESH_PAUSE_MS=3000
BLUESALES_REFRESH_LOOKBACK_DAYS=60

# Refresh-loop лидов (по id, как заказы): размер пачки, пауза (мс) и глубина
# активности (дни) — обновляем лидов с последним контактом не старше N дней.
BLUESALES_LEADS_REFRESH_BATCH_SIZE=50
BLUESALES_LEADS_PAUSE_MS=20000
BLUESALES_LEADS_REFRESH_LOOKBACK_DAYS=60
